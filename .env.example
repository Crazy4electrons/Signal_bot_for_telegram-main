# Pocket Option session/login. Keep .env private.
POCKETOPTION_SSID=
POCKETOPTION_UID=
POCKETOPTION_ACCOUNT_TYPE=DEMO
POCKETOPTION_EMAIL=
POCKETOPTION_PASSWORD=
POCKETOPTION_SCRAPER_HEADLESS=false
POCKETOPTION_SCRAPER_TIMEOUT=120

# Quotex session/login. Keep .env private.
QUOTEX_SSID=
QUOTEX_ACCOUNT_TYPE=DEMO
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_LANG=en
QUOTEX_IS_DEMO=true
QUOTEX_REGIONS=
# Use the existing persistent Edge profile for Quotex authorization.
# Set false to use the fork's saved-session login instead.
QUOTEX_BROWSER_SESSION=true
QUOTEX_BROWSER_HEADLESS=false
QUOTEX_BROWSER_AUTH_TIMEOUT=120
QUOTEX_SCRAPER_HEADLESS=false
QUOTEX_SCRAPER_TIMEOUT=120

# Shared secret required by POST /trade_signal. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it from MacroDroid as the header: x-webhook-secret
WEBHOOK_SECRET=

# Set to true to generate WEBHOOK_SECRET automatically the first time the app
# starts with no secret configured, then persist it to .env (mode 0600).
# The secret is generated ONCE, not on every start, because rotating it would
# invalidate the value stored in MacroDroid and reject every signal.
WEBHOOK_SECRET_AUTOGENERATE=false

# Optional: previous secret accepted during a rotation window. Set this to the
# old value, restart, update MacroDroid, then clear it and restart again.
WEBHOOK_SECRET_PREVIOUS=

# Direct Telegram channel listener
TELEGRAM_LISTENER_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Channels (id + required per-channel timezone/broker) live in channels.json so the
# same list can be reused on another host. See channels.json for the format.
TELEGRAM_CHANNELS_FILE=channels.json
TELEGRAM_SESSION_PATH=data/telegram_signal_bot
SIGNAL_BOT_STATE_PATH=data/signal_bot.sqlite3

# Persisted global risk defaults and per-broker overrides.
RISK_SETTINGS_FILE=risk_settings.json

# Legacy source hint (incomplete until a broker is assigned in Settings):
# TELEGRAM_SOURCE_CHANNEL=
# TELEGRAM_SIGNAL_PROVIDER=telegram
# SIGNAL_TIMEZONE=Etc/GMT-2

# Session capture (playwright_scraper.py) uses the installed Edge browser.
# Override only if Edge is not auto-detected:
# EDGE_BINARY=/usr/bin/microsoft-edge-stable
POCKETOPTION_PLAYWRIGHT_PROFILE=data/pocketoption-playwright
QUOTEX_PLAYWRIGHT_PROFILE=data/quotex-playwright

# Martingale safety limits
MARTINGALE_ENABLED=true
MAX_TRADE_AMOUNT=16
MAX_SEQUENCE_EXPOSURE=31
# Concurrent sequences allowed per broker account.
MAX_OPEN_TRADES=3
# Concurrent sequences allowed on the same asset (1 prevents conflicting
# same-asset sequences). Set to 0 to disable this check.
MAX_OPEN_TRADES_PER_ASSET=1
# Concurrent sequences allowed per signal provider (0 = unlimited).
MAX_OPEN_TRADES_PER_PROVIDER=0
# Age after which a sequence is assumed dead and its slot reclaimed.
# 0 derives it from timeframe x (martingale_levels + 1) x 2 + 120s.
STALE_SEQUENCE_SECONDS=0
MIN_BALANCE_RESERVE=0
