# Pocket Option session. Keep this file private.
ssid=

# Direct Telegram channel listener
TELEGRAM_LISTENER_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHANNEL=
TELEGRAM_SESSION_PATH=data/telegram_signal_bot
TELEGRAM_SIGNAL_PROVIDER=telegram
SIGNAL_TIMEZONE=Etc/GMT-2
SIGNAL_BOT_STATE_PATH=data/signal_bot.sqlite3

# Optional only when Selenium Manager cannot download a matching driver.
# EDGE_DRIVER=/absolute/path/to/msedgedriver

# Martingale safety limits
MARTINGALE_ENABLED=true
MAX_TRADE_AMOUNT=16
MAX_SEQUENCE_EXPOSURE=31
MAX_OPEN_TRADES=1
MIN_BALANCE_RESERVE=0
